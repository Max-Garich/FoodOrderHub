generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// Роли: USER (юзер), TEACHER (препод, без баланса),
// MANAGER (менеджер группы), CANTEEN_HEAD (глава столовой),
// SUPER_ADMIN (главный админ)
// ═══════════════════════════════════════════════
enum Role {
  USER
  TEACHER
  MANAGER
  CANTEEN_HEAD
  SUPER_ADMIN
}

// Статус заявки: PENDING (ждёт приёма), ACTIVE (принят), REJECTED (отклонён)
enum Status {
  PENDING
  ACTIVE
  REJECTED
}

model Group {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  paymentPhone String   @map("payment_phone")
  paymentBank  String   @map("payment_bank")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  users  User[]
  orders Order[]

  @@map("groups")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  name         String
  surname      String
  role         Role     @default(USER)
  status       Status   @default(PENDING)
  position     String? // должность преподавателя
  groupId      Int?     @map("group_id")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  group          Group?          @relation(fields: [groupId], references: [id])
  balance        Balance?
  orders         Order[]
  balanceHistory BalanceHistory[]
  favorites      Favorite[]
  topups         BalanceHistory[] @relation("BalanceHistoryManager")
  sessionsCreated OrderSession[] @relation("SessionCreator")

  @@map("users")
}

model Balance {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("balances")
}

model BalanceHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  managerId    Int?     @map("manager_id")
  amount       Float
  type         String // "topup" | "order_debit" | "admin_subtract" | "admin_order_correction"
  balanceAfter Float    @map("balance_after")
  orderId      Int?     @map("order_id")
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  user    User  @relation(fields: [userId], references: [id])
  manager User? @relation("BalanceHistoryManager", fields: [managerId], references: [id])

  @@map("balance_history")
}

model MenuItem {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  category           String?  @default("Прочее")
  defaultPrice       Float?   @map("default_price")
  defaultMaxQuantity Int?     @map("default_max_quantity") // последние использованные порции
  photoUrl           String?  @map("photo_url") // маленькое фото (data:image/... base64)
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at")

  dailyMenus DailyMenu[]
  favorites  Favorite[]

  @@map("menu_items")
}

model DailyMenu {
  id              Int      @id @default(autoincrement())
  sessionId       Int      @map("session_id")
  menuItemId      Int?     @map("menu_item_id")
  itemName        String   @map("item_name")
  category        String?  @default("Прочее")
  price           Float
  maxQuantity     Int      @map("max_quantity") // лимит порций, общий для всех групп
  orderedQuantity Int      @default(0) @map("ordered_quantity") // сколько уже куплено
  isAdditional    Boolean  @default(false) @map("is_additional") // доп-меню
  isAvailable     Boolean  @default(true) @map("is_available")
  photoUrl        String?  @map("photo_url") // фото из справочника блюд
  createdAt       DateTime @default(now()) @map("created_at")

  session    OrderSession @relation(fields: [sessionId], references: [id])
  menuItem   MenuItem?    @relation(fields: [menuItemId], references: [id])
  orderItems OrderItem[]

  @@map("daily_menus")
}

model OrderSession {
  id              Int       @id @default(autoincrement())
  createdByUserId Int       @map("created_by_user_id")
  sessionDate     String    @map("session_date") // YYYY-MM-DD
  isActive        Boolean   @default(false) @map("is_active")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  summaryJson     String?   @map("summary_json")

  createdBy  User        @relation("SessionCreator", fields: [createdByUserId], references: [id])
  dailyMenus DailyMenu[]
  orders     Order[]

  @@map("order_sessions")
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  sessionId   Int      @map("session_id")
  groupId     Int?     @map("group_id") // null = заказ преподавателя
  totalAmount Float    @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id])
  session OrderSession @relation(fields: [sessionId], references: [id])
  group   Group?       @relation(fields: [groupId], references: [id])
  items   OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int    @map("order_id")
  dailyMenuId Int    @map("daily_menu_id")
  itemName    String @map("item_name")
  price       Float
  quantity    Int
  subtotal    Float

  order     Order     @relation(fields: [orderId], references: [id])
  dailyMenu DailyMenu @relation(fields: [dailyMenuId], references: [id])

  @@map("order_items")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  menuItemId Int      @map("menu_item_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
  @@map("favorites")
}
